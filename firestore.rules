rules_version = '2';

// 数学ボードのアクセス規則。サーバーのプログラムがないので、
// 「誰が何を読めて、何を書き換えられるか」はすべてここで決める。
//
// - config/main の teacherUid の人が先生。それ以外は生徒。
// - 生徒は accounts/{uid} → students/{studentId} で本人を確かめる。
// - 生徒同士の回答（peers）には名前・班・提出時刻を入れない。

service cloud.firestore {
  match /databases/{database}/documents {

    function cfg(name) {
      return get(/databases/$(database)/documents/config/$(name)).data;
    }
    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/main)
        && cfg('main').teacherUid == request.auth.uid;
    }
    function hasAccount() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }
    function mySid() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.studentId;
    }
    function me() {
      return get(/databases/$(database)/documents/students/$(mySid())).data;
    }
    function myGroupKey() {
      return me().groupId == null ? '' : 'g_' + me().groupId;
    }
    function isMyKey(key) {
      return key == 'u_' + mySid() || (me().groupId != null && key == myGroupKey());
    }
    function task(t) {
      return get(/databases/$(database)/documents/tasks/$(t)).data;
    }
    function published(t) {
      return task(t).status in ['open', 'closed'];
    }
    // この課題で、自分（またはグループ）が提出するときの名前
    function ownerKeyFor(t) {
      return task(t).mode == 'group' ? myGroupKey() : 'u_' + mySid();
    }
    function mySubPath(t) {
      return /databases/$(database)/documents/tasks/$(t)/subs/$(ownerKeyFor(t));
    }
    function canSeePeers(t) {
      return published(t)
        && (task(t).peerView == 'on'
          || (task(t).peerView == 'after_submit' && ownerKeyFor(t) != '' && exists(mySubPath(t))));
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function optInt(v) {
      return v == null || v is int;
    }

    // ---------- 設定 ----------

    // クラス名・登録受付中か・先生の uid。ログイン前の画面でも読む
    match /config/main {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacherUid', 'className', 'registrationOpen']);
      allow update: if isTeacher()
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.keys().hasOnly(['teacherUid', 'className', 'registrationOpen']);
    }

    // 参加コード・正解・ヒント・提示画面の状態など、先生だけのもの
    match /config/{name} {
      allow read, write: if name != 'main' && isTeacher();
    }

    // ---------- ログイン名 ----------

    // 表示名 → ログイン用のメールアドレス。名前を知っていれば引けるが、一覧はできない
    match /names/{key} {
      allow get: if true;
      allow list: if isTeacher();
      allow create: if isTeacher()
        || (signedIn()
          && request.resource.data.keys().hasOnly(['email', 'studentId'])
          && request.resource.data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.studentId
            == request.resource.data.studentId);
      allow update: if isTeacher();
      allow delete: if isTeacher() || (hasAccount() && resource.data.studentId == mySid());
    }

    match /accounts/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isTeacher();
      allow list: if isTeacher();
      allow create: if isTeacher()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['studentId'])
          && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.uid == uid);
      allow delete: if isTeacher();
    }

    // ---------- 生徒・グループ ----------

    match /students/{sid} {
      allow get: if isTeacher() || (hasAccount() && mySid() == sid);
      allow list: if isTeacher();
      allow create: if isTeacher()
        || (signedIn()
          && cfg('main').registrationOpen == true
          && request.resource.data.keys().hasOnly(['name', 'number', 'uid', 'joinCode', 'groupId', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.joinCode == cfg('secret').joinCode
          && request.resource.data.groupId == null
          && str(request.resource.data.name, 20) && request.resource.data.name.size() > 0
          && optInt(request.resource.data.number));
      allow update: if isTeacher()
        || (hasAccount() && mySid() == sid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && str(request.resource.data.name, 20) && request.resource.data.name.size() > 0);
      allow delete: if isTeacher();
    }

    match /groups/{gid} {
      allow get: if isTeacher() || (hasAccount() && me().groupId == gid);
      allow list, write: if isTeacher();
    }

    // ---------- 課題 ----------

    match /tasks/{t} {
      allow get: if isTeacher() || (signedIn() && resource.data.status in ['open', 'closed']);
      allow list: if isTeacher() || (signedIn() && resource.data.status in ['open', 'closed']);
      allow write: if isTeacher();

      // 問題の画像
      match /files/{f} {
        allow read: if isTeacher() || (signedIn() && published(t));
        allow write: if isTeacher();
      }

      // 提出。キーは u_{生徒} か g_{グループ}
      match /subs/{key} {
        allow read: if isTeacher() || (hasAccount() && isMyKey(key));
        allow create, update: if isTeacher() || (hasAccount() && validStudentSubmit(t, key));
        allow delete: if isTeacher();

        match /files/{f} {
          allow read: if isTeacher() || (hasAccount() && isMyKey(key));
          allow write: if isTeacher()
            || (hasAccount() && key != '' && key == ownerKeyFor(t) && task(t).status == 'open'
              && f in ['drawing', 'photo'] && request.resource.data.keys().hasOnly(['data', 'v']));
        }
      }

      // みんなの考え（匿名のコピー）
      match /peers/{pid} {
        allow read: if isTeacher() || (hasAccount() && canSeePeers(t));
        allow create, update: if hasAccount() && ownsPeer(t, pid)
          && request.resource.data.keys().hasOnly(['shortAnswer', 'text', 'drawingV', 'photoV']);
        allow delete: if isTeacher();

        match /files/{f} {
          allow read: if isTeacher() || (hasAccount() && canSeePeers(t));
          allow write: if hasAccount() && ownsPeer(t, pid) && f in ['drawing', 'photo']
            && request.resource.data.keys().hasOnly(['data', 'v']);
        }
      }

      // 「参考になった」。ID は {peerId}_{uid}
      match /likes/{lid} {
        allow read: if isTeacher() || (hasAccount() && canSeePeers(t));
        allow create: if hasAccount() && canSeePeers(t)
          && request.resource.data.keys().hasOnly(['pid', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && lid == request.resource.data.pid + '_' + request.auth.uid
          && !(exists(mySubPath(t)) && get(mySubPath(t)).data.peerId == request.resource.data.pid);
        allow delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      }

      // 「わからない」
      match /help/{sid} {
        allow get: if isTeacher() || (hasAccount() && mySid() == sid);
        allow create, update: if hasAccount() && mySid() == sid && task(t).status == 'open'
          && request.resource.data.keys().hasOnly(['studentId', 'message', 'createdAt'])
          && request.resource.data.studentId == sid
          && str(request.resource.data.message, 200);
        allow delete: if isTeacher() || (hasAccount() && mySid() == sid);
      }
    }

    function ownsPeer(t, pid) {
      return task(t).status == 'open' && ownerKeyFor(t) != ''
        && getAfter(mySubPath(t)).data.peerId == pid;
    }

    // 生徒が書けるのは自分（グループ）の提出の中身だけ。クリアやコメントは先生だけが付ける
    function validStudentSubmit(t, key) {
      let d = request.resource.data;
      let isNew = resource == null;
      let wasCleared = !isNew && resource.data.status == 'cleared';
      return key != '' && key == ownerKeyFor(t)
        && task(t).status == 'open'
        && d.keys().hasOnly(['ownerKey', 'ownerType', 'ownerId', 'shortAnswer', 'text', 'confidence', 'drawingV',
          'photoV', 'status', 'autoCorrect', 'feedback', 'attempts', 'version', 'lastEditorId', 'lastEditorName',
          'updatedAt', 'peerId'])
        && d.ownerKey == key
        && d.version == (isNew ? 1 : resource.data.version + 1)
        && d.attempts == (isNew ? 1 : resource.data.attempts + 1)
        && d.feedback == (isNew ? '' : resource.data.feedback)
        && d.peerId == (isNew ? d.peerId : resource.data.peerId)
        && d.autoCorrect == null
        && d.lastEditorId == mySid()
        && str(d.text, 5000) && str(d.shortAnswer, 200)
        && (d.confidence == null || d.confidence in [1, 2, 3, 4])
        && (task(t).answerKind == 'short'
          ? d.status == 'pending'
          : d.status == (wasCleared ? 'cleared' : 'submitted'));
    }

    // ---------- コレクショングループ（一覧の読み込み） ----------

    match /{path=**}/subs/{key} {
      allow read: if isTeacher()
        || (hasAccount() && (resource.data.ownerKey == 'u_' + mySid()
          || (me().groupId != null && resource.data.ownerKey == 'g_' + me().groupId)));
    }
    match /{path=**}/help/{sid} {
      allow read: if isTeacher() || (hasAccount() && resource.data.studentId == mySid());
    }
    match /{path=**}/likes/{lid} {
      allow read: if isTeacher();
    }
  }
}
